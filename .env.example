# SeaAir Mobile App API Environment Variables

# Server
PORT=3000

# Message broker selection: "memory" (legacy in-process) or "redis" (Streams on ElastiCache)
MESSAGE_BROKER=redis

# Redis (ElastiCache for Redis OSS) - required when MESSAGE_BROKER=redis
REDIS_HOST=master.seaair-msgbroker.ynngu6.use2.cache.amazonaws.com
REDIS_PORT=6379
REDIS_TLS=true

# Redis AUTH token. App Runner injects REDIS_AUTH_TOKEN from Secrets Manager
# (see seaair/redis/auth-token). For local dev, set one of:
#   REDIS_AUTH_TOKEN=<paste token here>
#   REDIS_AUTH_TOKEN_SECRET_ARN=arn:aws:secretsmanager:us-east-2:120569623207:secret:seaair/redis/auth-token-yQHQDc
# REDIS_AUTH_TOKEN=
# REDIS_AUTH_TOKEN_SECRET_ARN=

# Redis Streams retention - max entries per stream before older entries are
# trimmed (~ is approximate trim, much faster than exact trim).
#
# STREAM_LIVE_MAXLEN is the Tier-1 *live window* per controller (count): kept
# small by design so Redis memory is bounded by (controllers x live-window),
# never by total history (durable history lives in the Tier-2 archive below).
# Default 5000 ~= 7h at a 5s cadence, ~1.5 MB/controller. If unset, the broker
# falls back to STREAM_MAXLEN, then to 5000. This is the OOM backstop — keep it
# bounded regardless of device count.
STREAM_LIVE_MAXLEN=5000
# Legacy/fallback bound (still honored if STREAM_LIVE_MAXLEN is unset).
STREAM_MAXLEN=1000000

# --- Tier-2 durable archive (analytics history + reconnect fallback) ---------
# Master toggle (FR-10). Off by default; flip to true only AFTER the DynamoDB
# table below exists and the instance role has access. When false, archiving
# is a no-op and the analytics endpoint returns 503.
ARCHIVE_ENABLED=false
# Backing store. Only "dynamodb" is implemented.
ARCHIVE_STORE=dynamodb
# History retention window in days (FR-4). Default 4, hard-capped at 7.
ARCHIVE_RETENTION_DAYS=4
# DynamoDB table for archived heartbeats. PK controllerId (S), SK ts (N,
# epoch ms), TTL attribute `ttl`. See docs/tiered-retention.md for setup.
DDB_HISTORY_TABLE=controller-history
# Gap (seconds) beyond which an unchanged heartbeat is recorded as a new
# comms-resume point rather than a repeat, so lost-comms windows stay visible.
ARCHIVE_GAP_SECONDS=60
# Cap on raw analytics points before resolution is auto-escalated (FR-6).
ANALYTICS_MAX_RAW_POINTS=5000

# Admin token for /admin/* inspection endpoints. App Runner injects from
# Secrets Manager (seaair/api/admin-token). Required to call /admin/streams.
# ADMIN_TOKEN=

# AWS Cognito (required for JWT authentication on /mobile and /config)
COGNITO_USER_POOL_ID=us-east-2_Z6wNcT7sN
COGNITO_CLIENT_ID=40b923fpk6c5v1lvatbcqbdakq
AWS_REGION=us-east-2

# Dashboard backend
# Cognito group whose members can use the support dashboard.
# Toggled per-user via /dashboard/api/admin/users/:username/{grant,revoke}.
DASHBOARD_ADMIN_GROUP=dashboard-admin
# DynamoDB table name for help beacons (1-year TTL on `expiresAt`).
BEACONS_TABLE_NAME=seaair-beacons

# AWS Credentials - prefer IAM roles in production. App Runner uses the
# instance role automatically; only set these for local development.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Logging Level (optional)
# LOG_LEVEL=info
