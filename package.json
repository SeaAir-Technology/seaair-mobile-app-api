    "jwks-rsa": "^3.2.0",
    "morgan": "^1.10.1",
    "protobufjs": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
