# Cognito Hosted UI configuration for the support dashboard.
# Vite inlines these into the JS bundle at build time. They are PUBLIC values;
# do not put secrets here. Override per-environment via Docker build args.

# Cognito User Pool issuer URL (used to discover OIDC endpoints / JWKS).
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_Z6wNcT7sN

# App client ID for the dashboard SPA. The aws CLI command in the PR body
# creates a public (no-secret) SPA client; paste the returned ClientId here.
VITE_COGNITO_CLIENT_ID=

# Hosted UI domain (host only, no scheme, no path). The pool already has a
# Cognito-prefixed domain provisioned: us-east-2z6wnct7sn.
VITE_COGNITO_DOMAIN=us-east-2z6wnct7sn.auth.us-east-2.amazoncognito.com

# Where Cognito redirects after sign-in / sign-out. Must exactly match the
# values registered on the Cognito app client. SPA lives at the root of
# dashboard.seaair.com.
VITE_COGNITO_REDIRECT_URI=https://dashboard.seaair.com/
VITE_COGNITO_LOGOUT_URI=https://dashboard.seaair.com/

# Backend API base path. Same-origin in production; for local dev the Vite
# proxy in vite.config.ts handles forwarding to localhost:3000.
VITE_API_BASE=/dashboard/api
